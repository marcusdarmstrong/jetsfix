{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jetsfix",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Preview phase: the editor evaluates EmDash here while Ghost keeps serving
	// jetsfix.com. At cutover, swap this route (and EMDASH_SITE_URL) to
	// jetsfix.com + www.jetsfix.com — see README "Cutover".
	"routes": [{ "pattern": "jetsfix-preview.com", "custom_domain": true }],
	"vars": {
		// Passkeys are bound to this origin; set before running the setup wizard.
		"EMDASH_SITE_URL": "https://jetsfix-preview.com",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jetsfix",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "jetsfix-media",
		},
	],
	// Sandboxed plugins need Worker Loader (Workers Paid). Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// Scheduled publishing + maintenance. Must match createScheduledHandler() in src/worker.ts.
	"triggers": {
		"crons": ["* * * * *"],
	},
	"observability": { "enabled": true },
}
