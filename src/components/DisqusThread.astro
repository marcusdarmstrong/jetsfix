---
/**
 * Disqus comments, as on the Ghost site.
 *
 * The old theme set `page.url` to the post's http://www.jetsfix.com/<slug>/
 * URL and left `page.identifier` empty, so Disqus keys every existing thread
 * by that exact URL. We keep passing it verbatim — the post now lives at
 * https, but its thread key must not move.
 *
 * Note for the preview period: comments posted on jetsfix-preview.com land in
 * the same, real threads. If Disqus "Trusted Domains" is configured, add
 * jetsfix-preview.com there or the widget will refuse to load on the preview.
 */
import { DISQUS_SHORTNAME, legacyPostUrl } from "../utils/hosts";

interface Props {
	slug: string;
}

const { slug } = Astro.props;
const pageUrl = legacyPostUrl(slug);
---

<section class="post-comments" aria-label="Comments">
	<div id="disqus_thread"></div>
	<script is:inline define:vars={{ pageUrl, shortname: DISQUS_SHORTNAME }}>
		window.disqus_config = function () {
			this.page.url = pageUrl;
		};
		(function () {
			var d = document;
			var s = d.createElement("script");
			s.src = "https://" + shortname + ".disqus.com/embed.js";
			s.setAttribute("data-timestamp", String(+new Date()));
			(d.head || d.body).appendChild(s);
		})();
	</script>
	<noscript>
		Please enable JavaScript to view the
		<a href="https://disqus.com/?ref_noscript">comments powered by Disqus.</a>
	</noscript>
</section>

<style>
	.post-comments {
		margin-block-start: var(--spacing-16, 4rem);
		padding-block-start: var(--spacing-10, 2.5rem);
		border-block-start: 1px solid var(--color-border);
	}
</style>
